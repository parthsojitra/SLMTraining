# ============================================================
# SLM-SMS Environment Variables — copy to .env and customise
# ============================================================

# ----------------------------------------------------------
# Model Configuration
# ----------------------------------------------------------
# HuggingFace model ID or local path
SLM_MODEL_ID=Qwen/Qwen3.5-2B

# Pin to a specific commit hash to prevent supply-chain risk.
# Leave blank to use the latest revision (not recommended for production).
# Example: SLM_MODEL_REVISION=abc1234def5678
SLM_MODEL_REVISION=

# Path to a trained LoRA adapter directory (leave blank to use the base model)
SLM_ADAPTER_PATH=

# ----------------------------------------------------------
# Model Caching (P3 #14)
# ----------------------------------------------------------
# Directory where HuggingFace stores downloaded model weights.
# Mount a persistent volume here in containers / cloud so weights survive restarts.
# Default: ~/.cache/huggingface
HF_HOME=/path/to/model/cache

# Mirror for HuggingFace Hub (useful in air-gapped environments)
# HF_ENDPOINT=https://huggingface.co

# ----------------------------------------------------------
# Server
# ----------------------------------------------------------
# Comma-separated list of allowed CORS origins
SLM_CORS_ORIGINS=http://localhost:3000

# API key (set a strong random value in production)
SLM_API_KEY=changeme

# Start without loading the model (useful for health-check-only pods)
SLM_LAZY_LOAD=false

# Number of threads in the inference thread pool (keep = number of GPUs)
SLM_INFERENCE_THREADS=1

# ----------------------------------------------------------
# Graceful Shutdown (P3 #15)
# ----------------------------------------------------------
# Seconds to wait for in-flight requests to drain before releasing the engine
SLM_DRAIN_SECONDS=10

# ----------------------------------------------------------
# Gunicorn (P3 #16)
# ----------------------------------------------------------
GUNICORN_WORKERS=1
GUNICORN_PORT=8000
GUNICORN_TIMEOUT=120

# ----------------------------------------------------------
# Logging (P2 #10)
# ----------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR
SLM_LOG_LEVEL=INFO

# Emit newline-delimited JSON logs (auto-detected: true in non-TTY environments)
# SLM_LOG_JSON=true
