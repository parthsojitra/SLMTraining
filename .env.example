# ============================================================
# SLM-SMS Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ----------------------------------------------------------
# Model Configuration
# ----------------------------------------------------------
# HuggingFace model ID or local path to the base model
SLM_MODEL_ID=Qwen/Qwen3.5-2B

# Pin to a specific commit hash for reproducibility and supply-chain safety.
# Leave blank to use the latest revision (not recommended for production).
# Find commit hashes on: https://huggingface.co/Qwen/Qwen3.5-2B/commits/main
# Example: SLM_MODEL_REVISION=abc1234def5678
SLM_MODEL_REVISION=

# Path to a trained LoRA adapter directory (leave blank to use the base model)
SLM_ADAPTER_PATH=

# ----------------------------------------------------------
# Model Caching
# ----------------------------------------------------------
# Directory where HuggingFace stores downloaded model weights.
# Mount a persistent volume here in containers / cloud to avoid re-downloading on restart.
# Default when unset: ~/.cache/huggingface
HF_HOME=/path/to/model/cache

# HuggingFace mirror endpoint (useful in air-gapped / restricted environments)
# HF_ENDPOINT=https://huggingface.co

# ----------------------------------------------------------
# Inference
# ----------------------------------------------------------
# Max tokens the model may generate per request (keep low for JSON extraction)
SLM_MAX_NEW_TOKENS=128

# Sampling temperature — 0 = greedy (deterministic), 0.01 = near-greedy
SLM_TEMPERATURE=0.01

# Nucleus sampling probability (top-p)
SLM_TOP_P=0.95

# ----------------------------------------------------------
# Server
# ----------------------------------------------------------
# Comma-separated list of allowed CORS origins (no wildcard — credentials are enabled)
SLM_CORS_ORIGINS=http://localhost:3000

# API key — set a strong random value in production (blank = no key enforcement)
SLM_API_KEY=changeme

# Start without loading the model at startup (useful for health-check-only pods)
SLM_LAZY_LOAD=false

# Number of threads in the inference thread pool.
# Keep equal to the number of GPUs (or 1 on CPU / MPS).
SLM_INFERENCE_THREADS=1

# ----------------------------------------------------------
# Graceful Shutdown
# ----------------------------------------------------------
# Seconds to drain in-flight requests before releasing the engine on SIGTERM
SLM_DRAIN_SECONDS=10

# ----------------------------------------------------------
# Gunicorn (production ASGI server)
# ----------------------------------------------------------
# Keep GUNICORN_WORKERS=1 per GPU. Scale by deploying more pods, not more workers.
GUNICORN_WORKERS=1
GUNICORN_PORT=8000
GUNICORN_TIMEOUT=120

# ----------------------------------------------------------
# Logging
# ----------------------------------------------------------
# Log level: DEBUG | INFO | WARNING | ERROR
SLM_LOG_LEVEL=INFO

# Force JSON log output (auto-detected: JSON on non-TTY; plain text on TTY)
# SLM_LOG_JSON=true
